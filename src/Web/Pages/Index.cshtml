@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<table>
    @for(int row = 0; row < 8; row++) {
        <tr>
        @for(int column = 0; column < 8; column++) {
            var color = (row+column) % 2 == 0 ? "b" : "w"; // Switches between black and white squares
            var id = ""+(char)(column+97)+(row+1); // converts column to letters, starting from a(97)
            <th class = "@color" id="@id"></th>
        }
        </tr>
    }
</table>
